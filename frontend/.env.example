# Copy to .env.local for local overrides, or set as an environment variable
# in your hosting provider (e.g. Vercel Project Settings -> Environment Variables).
#
# Leave unset for local dev — vite.config.ts already proxies /api to
# http://localhost:8086.
#
# For production, point it at your deployed backend, including the /api suffix:
VITE_API_BASE_URL=https://airbnb-clone-gz4j.onrender.com/api
